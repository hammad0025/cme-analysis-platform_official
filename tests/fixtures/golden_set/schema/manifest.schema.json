{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CME golden set manifest",
  "type": "object",
  "required": ["schema_version", "clips"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "frames_dir", "eval_frame_glob", "expected"],
        "properties": {
          "id": { "type": "string" },
          "notes": { "type": "string" },
          "frames_dir": { "type": "string" },
          "eval_frame_glob": { "type": "string" },
          "expected": { "type": "object" },
          "match": { "type": "object" }
        }
      }
    }
  }
}
