# Frontend environment variables — copy to `.env.local` before `npm start`.
#   cp .env.example .env.local
#
# Localhost demo (Tim / Osborne session): use the values below as-is.
# Offline-only demo (no AWS): clear REACT_APP_API_URL and set REACT_APP_USE_MOCK_API=true.

# --- Backend wiring ---
REACT_APP_API_URL=https://g4dzem9rtk.execute-api.us-east-1.amazonaws.com/prod

# Cognito — only used when REACT_APP_DEV_MODE=false
REACT_APP_USER_POOL_ID=us-east-1_t8m33Ihhq
REACT_APP_USER_POOL_WEB_CLIENT_ID=42e444v111efsa21b6b3v09svp

# --- Local demo ---
# Skip Cognito; auto-signs in as Demo Reviewer
REACT_APP_DEV_MODE=true

# false = live API (requires REACT_APP_API_URL). true = browser-only mock.
# Lockdown: REACT_APP_USE_MOCK_API=false without REACT_APP_API_URL falls back to mock.
REACT_APP_USE_MOCK_API=false
