# Copy to .env and fill in keys (never commit .env — it is gitignored).
# Validate: python scripts/validate_env.py --analyze

# =============================================================================
# REQUIRED for local paid analysis (analyze_cme_full.py, run_claim_verifier.py)
# =============================================================================

# Cost gate — must be exactly 1 to run local scripts that call paid APIs.
# Without this, analyze_cme_full.py and run_claim_verifier.py refuse to run.
CME_ALLOW_LOCAL_ANALYSIS=1

# Primary vision + text analysis (Anthropic is the default provider).
ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# OPTIONAL — only when explicitly enabled on the command line
# =============================================================================

# Perplexity Sonar — used ONLY when you pass --with-research (NOT auto-enabled).
# Get a key at https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# OpenAI / Gemini — used ONLY when analyze_cme_full.py --providers includes them.
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Override default vision provider (anthropic | openai | gemini).
# CME_VISION_PROVIDER=anthropic

# =============================================================================
# PRODUCTION ONLY — AWS Lambda uses IAM; no local key needed
# =============================================================================
# Bedrock models are configured in CDK / Lambda environment, not in .env.
